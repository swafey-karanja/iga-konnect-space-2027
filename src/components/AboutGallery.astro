---
import { galleryImages } from "../data/about";

// Three identical groups let the track loop seamlessly by moving one group's width.
const groups = [0, 1, 2];
---

{
    galleryImages.length > 0 && (
    <div class="about-gallery py-9" role="group" aria-label="Photo gallery">
        <div class="about-gallery__track">
            {groups.map((group) => (
                    <ul class="about-gallery__group" aria-hidden={group > 0 ? "true" : undefined}>
                        {galleryImages.map((image, index) => (
                                <li
                                        class:list={[
                                            "shrink-0 overflow-hidden rounded-sm",
                                            index % 2 === 0 ? "about-gallery__tile--tall" : "about-gallery__tile--short",
                                        ]}
                                >
                                    <img
                                            src={image.src}
                                            alt={group === 0 ? image.alt : ""}
                                            loading="lazy"
                                            decoding="async"
                                            class="block size-full object-cover"
                                    />
                                </li>
                        ))}
                    </ul>
            ))}
        </div>
    </div>
        )
    }

<style>
    .about-gallery {
        --gap: 0.75rem;
        --scale: 0.55;
        overflow: hidden;
    }

    @media (min-width: 640px) {
        .about-gallery {
            --gap: 1rem;
            --scale: 0.75;
        }
    }

    @media (min-width: 1024px) {
        .about-gallery {
            --gap: 1.125rem;
            --scale: 1;
        }
    }

    .about-gallery__track {
        display: flex;
        width: max-content;
        animation: about-gallery-scroll 60s linear infinite;
        will-change: transform;
    }

    /* Tiles are centred vertically, so tall and short images share a midline */
    .about-gallery__group {
        display: flex;
        flex-shrink: 0;
        align-items: center;
        gap: var(--gap);
        padding-right: var(--gap);
    }

    /* Tall tile: 360 x 486 at full size. Short tile: 324 x 324 square. */
    .about-gallery__tile--tall {
        width: calc(40.5rem * var(--scale));
        height: calc(28.375rem * var(--scale));
    }

    .about-gallery__tile--short {
        width: calc(30.25rem * var(--scale));
        height: calc(20.25rem * var(--scale));
    }

    @keyframes about-gallery-scroll {
        to {
            transform: translateX(-33.3333%);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .about-gallery__track {
            animation: none;
        }
    }
</style>