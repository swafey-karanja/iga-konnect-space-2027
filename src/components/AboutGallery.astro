
---
import { galleryImages } from "../data/about";

// Three identical groups allow the animation to loop seamlessly.
const groups = [0, 1, 2];
---

{
    galleryImages.length > 0 && (
    <div
            class="about-gallery bg-ink py-6"
            role="group"
            aria-label="Photo gallery"
    >
        <div class="about-gallery__track">
            {groups.map((group) => (
                    <ul
                            class="about-gallery__group"
                            aria-hidden={group > 0 ? "true" : undefined}
                    >
                        {galleryImages.map((image, index) => (
                                <li
                                        class:list={[
                                            "about-gallery__tile shrink-0 overflow-hidden rounded-sm",
                                            index % 2 === 0
                                                ? "about-gallery__tile--tall"
                                                : "about-gallery__tile--short",
                                        ]}
                                >
                                    <img
                                            src={image.src}
                                            alt={group === 0 ? image.alt : ""}
                                            loading="lazy"
                                            decoding="async"
                                            class="block size-full object-cover"
                                    />
                                </li>
                        ))}
                    </ul>
            ))}
        </div>
    </div>
        )
    }

<style>
    .about-gallery {
        --gap: clamp(0.35rem, 0.55vw, 0.85rem);

        overflow: hidden;
    }

    .about-gallery__track {
        display: flex;
        width: max-content;
        animation: about-gallery-scroll 60s linear infinite;
        will-change: transform;
    }

    .about-gallery__group {
        display: flex;
        flex-shrink: 0;
        align-items: center;
        gap: var(--gap);
        padding-right: var(--gap);
    }

    /* Images retain their natural aspect ratios and determine their own widths. */
    .about-gallery__tile {
        flex-shrink: 0;
        overflow: hidden;
    }

    .about-gallery__tile--tall {
        height: clamp(15rem, 22.6vw, 25rem);
    }

    .about-gallery__tile--short {
        height: clamp(12rem, 15vw, 20rem);
    }

    .about-gallery__tile img {
        display: block;
        width: auto;
        height: 100%;
        object-fit: cover;
    }

    @keyframes about-gallery-scroll {
        to {
            transform: translateX(-33.3333%);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .about-gallery__track {
            animation: none;
        }
    }
</style>
