---
import AboutGallery from "../AboutGallery.astro";
import { aboutContent } from "../../data/about";

const { heading, paragraphs, stats, cta } = aboutContent;
---

<section
        id="about"
        aria-labelledby="about-heading"
        class="relative overflow-hidden bg-ink py-16 text-cream lg:py-32"
>
    <div class="mx-auto w-[92%] max-w-[1700px] gap-10 sm:w-[90%] lg:gap-12 xl:gap-16">
        <div class="flex flex-col gap-2">
            <h2
                    id="about-heading"
                    class="about-heading font-semibold leading-[1.4] tracking-tight"
            >
                {heading.lead}{" "}

            </h2>
            <h2 class="box-decoration-clone bg-brand-bright px-2 py-1 text-ink about-heading font-semibold leading-[1.15] tracking-tight w-fit">
                {heading.highlight}
              </h2>
        </div>


        <div class="mt-12 grid gap-x-10 gap-y-12 lg:mt-20 lg:grid-cols-3 lg:items-start">
            <div class="flex flex-col gap-6 text-sm leading-relaxed text-cream/70 sm:text-base lg:col-start-3 lg:row-start-1">
                {paragraphs.map((paragraph) => <p>{paragraph}</p>)}

          <!--      <a-->
          <!--              href={cta.href}-->
          <!--              class="group mt-2 flex h-14 w-fit items-center gap-6 rounded-full border border-orange py-1 pr-1 pl-6 font-heading text-sm font-medium tracking-wide whitespace-nowrap text-black uppercase transition-colors duration-300 bg-orange/80 hover:bg-orange focus-visible:outline-cream"-->
          <!--      >-->
          <!--          {cta.label}-->
          <!--          <span class="grid size-11 place-items-center rounded-full bg-cream text-brand" aria-hidden="true">-->
          <!--  <svg-->
          <!--          class="size-5 transition-transform duration-300 group-hover:translate-x-0.5"-->
          <!--          viewBox="0 0 24 24"-->
          <!--          fill="none"-->
          <!--          stroke="currentColor"-->
          <!--          stroke-width="1.75"-->
          <!--          stroke-linecap="round"-->
          <!--          stroke-linejoin="round"-->
          <!--  >-->
          <!--    <path d="M5 12h14" />-->
          <!--    <path d="m12 5 7 7-7 7" />-->
          <!--  </svg>-->
          <!--</span>-->
          <!--      </a>-->
            </div>

            {
                stats.map((stat) => (
                        <div class="lg:row-start-1 lg:pt-20">
                            <p class="about-stat font-heading font-medium leading-none">{stat.value}</p>
                            <p class="mt-8 max-w-xs border-t border-cream/20 pt-5 text-md leading-relaxed text-cream/70 sm:text-lg font-semibold lg:mt-10">
                                {stat.description}
                            </p>
                        </div>
                ))
            }
        </div>
    </div>

    <div class="mt-16">
        <AboutGallery />
    </div>
</section>

<style>
    .about-heading {
        font-size: clamp(1.75rem, 4vw, 3rem);
    }

    .about-stat {
        font-size: clamp(3.5rem, 8vw, 7rem);
    }
</style>