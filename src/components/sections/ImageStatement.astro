---
import { statementContent } from "../../data/statement";

const { text, imageSrc } = statementContent;
---

<section class="statement" aria-labelledby="statement-heading" data-statement>
    <!-- Taller than the section so it can drift slowly for the parallax -->
    <div class="statement__image" data-statement-image>
        <img
                src={imageSrc}
                alt=""
                loading="lazy"
                decoding="async"
                class="size-full object-cover"
        />
    </div>

    <!-- Darkens the image so the text stays readable -->
    <div class="absolute inset-0 bg-ink/45"></div>

    <div class="relative flex size-full items-center justify-center px-6">
        <h2
                id="statement-heading"
                class="statement__text max-w-11/12 lg:max-w-9/12 text-center font-bold leading-none tracking-tight text-cream"
        >
            {text}
        </h2>
    </div>
</section>

<!-- Scroll distance during which the image stays pinned after the section before it has gone -->
<div class="statement-spacer" aria-hidden="true" data-statement-spacer></div>

<style>
    /*
      Pinned to the screen while the section before it scrolls away (the reveal),
      while the spacer scrolls past (the hold), and while the next section slides over it (the cover).
    */
    .statement {
        position: sticky;
        top: 0;
        bottom: 0;
        z-index: 10;
        height: 100lvh;
        overflow: hidden;
        background-color: var(--color-ink);
    }

    .statement-spacer {
        /* How long the image stays fully visible between the reveal and the cover */
        --dwell: 50lvh;
        /* 100lvh covers the slide-over, the dwell is the pause */
        height: calc(100lvh + var(--dwell));
    }

    .statement__image {
        position: absolute;
        inset: -10% 0;
        transform: translate3d(0, var(--shift, 0px), 0);
        will-change: transform;
    }

    .statement__text {
        font-size: clamp(3.75rem, 5vw, 6rem);
    }

    /* Reduced motion: a plain full-screen image that scrolls normally */
    @media (prefers-reduced-motion: reduce) {
        .statement {
            position: relative;
        }

        .statement-spacer {
            display: none;
        }

        .statement__image {
            inset: 0;
            transform: none;
        }
    }
</style>

<script>
    const section = document.querySelector<HTMLElement>("[data-statement]");
    const spacer = document.querySelector<HTMLElement>("[data-statement-spacer]");
    const image = section?.querySelector<HTMLElement>("[data-statement-image]");
    const prefersReducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
    ).matches;

    if (section && spacer && image && !prefersReducedMotion) {
        // Total drift of the image, as a fraction of the section height.
        // The image layer overhangs by 10% each side, so keep this below 0.2.
        const drift = 0.18;
        let frameRequested = false;

        const update = () => {
            frameRequested = false;

            const height = section.offsetHeight;

            // The image is pinned from the moment the section before it starts to lift away
            // (the spacer's top is two screens down) until the spacer has scrolled out.
            const progress = Math.min(
                Math.max(
                    (2 * height - spacer.getBoundingClientRect().top) /
                    (height + spacer.offsetHeight),
                    0,
                ),
                1,
            );

            // The image drifts up slowly while the sections around it move at full speed.
            const shift = (0.5 - progress) * drift * height;
            image.style.setProperty("--shift", `${shift}px`);
        };

        const requestUpdate = () => {
            if (!frameRequested) {
                frameRequested = true;
                requestAnimationFrame(update);
            }
        };

        window.addEventListener("scroll", requestUpdate, { passive: true });
        window.addEventListener("resize", requestUpdate);
        update();
    }
</script>