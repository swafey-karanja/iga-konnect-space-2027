---
import { statementContent } from "../../data/statement";

const { text, imageSrc } = statementContent;
---

<section class="statement" aria-labelledby="statement-heading" data-statement>
    <div class="statement__pin" data-statement-pin>
        <!-- Taller than the pin so it can drift slowly for the parallax -->
        <div class="statement__image" data-statement-image>
            <img
                    src={imageSrc}
                    alt=""
                    loading="lazy"
                    decoding="async"
                    class="size-full object-cover"
            />
        </div>

        <!-- Darkens the image so the text stays readable -->
        <div class="absolute inset-0 bg-ink/15"></div>

        <div class="relative flex size-full items-center justify-center px-6">
            <h2
                    id="statement-heading"
                    class="statement__text max-w-full text-center font-bold leading-none tracking-tight text-cream"
            >
                {text}
            </h2>
        </div>
    </div>
</section>

<style>
    .statement {
        /* How long the image stays fully visible between the reveal and the cover */
        --dwell: 50lvh;
        position: relative;
        z-index: 10;
        /* 100lvh reveal + 100lvh image + 100lvh cover + dwell */
        height: calc(300lvh + var(--dwell));
        /* Tucks the image under the section before it and beneath the section after it */
        margin-block: -100lvh;
    }

    .statement__pin {
        position: sticky;
        top: 0;
        height: 100lvh;
        overflow: hidden;
        background-color: var(--color-ink);
    }

    .statement__image {
        position: absolute;
        inset: -10% 0;
        transform: translate3d(0, var(--shift, 0px), 0);
        will-change: transform;
    }

    .statement__text {
        font-size: clamp(2.75rem, 9vw, 9rem);
    }

    /* Reduced motion: a plain full-screen image that scrolls normally */
    @media (prefers-reduced-motion: reduce) {
        .statement {
            height: 100lvh;
            margin-block: 0;
        }

        .statement__pin {
            position: relative;
        }

        .statement__image {
            inset: 0;
            transform: none;
        }
    }
</style>

<script>
    const section = document.querySelector<HTMLElement>("[data-statement]");
    const pin = section?.querySelector<HTMLElement>("[data-statement-pin]");
    const image = section?.querySelector<HTMLElement>("[data-statement-image]");
    const prefersReducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
    ).matches;

    if (section && pin && image && !prefersReducedMotion) {
        // Total drift of the image, as a fraction of the pinned height.
        // The image layer overhangs by 10% each side, so keep this below 0.2.
        const drift = 0.18;
        let frameRequested = false;

        const update = () => {
            frameRequested = false;

            // Progress through the pinned stretch: 0 as it starts to stick, 1 as it lets go.
            const travel = section.offsetHeight - pin.offsetHeight;
            const progress = Math.min(
                Math.max(-section.getBoundingClientRect().top / travel, 0),
                1,
            );

            // The image drifts up slowly while the sections around it move at full speed.
            const shift = (0.5 - progress) * drift * pin.offsetHeight;
            image.style.setProperty("--shift", `${shift}px`);
        };

        const requestUpdate = () => {
            if (!frameRequested) {
                frameRequested = true;
                requestAnimationFrame(update);
            }
        };

        window.addEventListener("scroll", requestUpdate, { passive: true });
        window.addEventListener("resize", requestUpdate);
        update();
    }
</script>