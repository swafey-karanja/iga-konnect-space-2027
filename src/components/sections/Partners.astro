---
import LogoRow from "../LogoRow.astro";
import {partnersContent} from "../../data/partners.ts";

const { heading, logos } = partnersContent;

// The second row shows the same logos starting from the middle, so the rows don't mirror each other.
const half = Math.ceil(logos.length / 2);
const secondRowLogos = [...logos.slice(half), ...logos.slice(0, half)];
---

<section
        id="partners"
        aria-labelledby="partners-heading"
        class="bg-cream py-16 text-ink"
>
    <div class="mx-auto w-[92%] max-w-[1700px] gap-10 sm:w-[90%] flex flex-col items-center justify-center">
        <h2
                id="partners-heading"
                class="partners-heading font-semibold leading-[1.4] tracking-tight"
        >
            {heading.lead}{" "}<span class="box-decoration-clone bg-brand-bright px-2 text-cream">
            {heading.highlight}
          </span>

        </h2>
      <!--  <h2 class="partners-heading font-semibold leading-[1.35] tracking-tight box-decoration-clone bg-brand-bright px-2 text-cream">-->
      <!--  -->
      <!--</h2>-->
    </div>

    <div class="mt-12 flex flex-col gap-3 sm:gap-4 lg:mt-16" role="group" aria-label="Company logos">
        <LogoRow logos={logos} duration="50s" />
        <LogoRow logos={secondRowLogos} reverse duration="60s" decorative />
    </div>
</section>

<style>
    .partners-heading {
        font-size: clamp(1.45rem, 4vw, 3rem);
    }
</style>